# Appium Server Connection
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Android Device / Emulator Settings
PLATFORM_NAME=Android
PLATFORM_VERSION=14.0
ANDROID_DEVICE_NAME=Android Emulator
AUTOMATION_NAME=UiAutomator2

# Application Package / APK Path
# Option 1: Path to locally built Expo Development APK (preferred)
APP_PATH=./apps/app-debug.apk

# Option 2: Installed app package and main activity
APP_PACKAGE=com.anonymous.app
APP_ACTIVITY=.MainActivity

# Timeouts in seconds
EXPLICIT_WAIT=15
IMPLICIT_WAIT=3

# API and Credentials for testing
API_BASE_URL=http://10.0.2.2:8080/api/v1
TEST_EMAIL=superadmin@ddas.com
TEST_PASSWORD=SuperAdmin@123
VIEWER_EMAIL=viewer@ddas.com
VIEWER_PASSWORD=Viewer@123
