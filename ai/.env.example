# ============================================================================
# DDAS AI Service (FastAPI) Configuration Template
# ============================================================================

# Spring Boot internal ML API connectivity
# For local dev: http://127.0.0.1:8080/api/v1/internal/ml
# In Docker Compose: http://api:8080/api/v1/internal/ml
DDAS_AI_SPRING_DATA_BASE_URL=http://127.0.0.1:8080/api/v1/internal/ml
DDAS_AI_SPRING_TIMEOUT_SECONDS=10

# Two different secret tokens (min 32 characters each)
# 1) Spring Boot -> FastAPI (for triggering jobs & predictions)
DDAS_AI_INCOMING_SERVICE_TOKEN=your_32_plus_char_incoming_token_here
# 2) FastAPI -> Spring Boot (for reading dam/sensor data)
DDAS_AI_SPRING_SERVICE_TOKEN=your_32_plus_char_spring_data_token_here

# Public Swagger/OpenAPI docs at http://127.0.0.1:8000/docs (local dev only)
DDAS_AI_ENABLE_DOCS=true

# MLOps & Model Artifacts
DDAS_AI_ML_ARTIFACTS_DIR=artifacts/ml
DDAS_AI_MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Qdrant Vector Database
# Local Docker container (ddas-qdrant) mapped to localhost:6333
DDAS_AI_QDRANT_URL=http://127.0.0.1:6333
DDAS_AI_QDRANT_API_KEY=
DDAS_AI_QDRANT_COLLECTION=ddas_rag_documents

# MinIO Object / Blob Storage
# Local Docker container (ddas-minio) S3 API on localhost:9000
DDAS_AI_MINIO_ENDPOINT=127.0.0.1:9000
DDAS_AI_MINIO_ACCESS_KEY=minioadmin
DDAS_AI_MINIO_SECRET_KEY=minioadmin
DDAS_AI_MINIO_SECURE=false
DDAS_AI_MINIO_BUCKET=ddas-artifacts

# Gemini LLM & Embedding Settings for RAG
DDAS_AI_GEMINI_API_KEY=your_gemini_api_key_here
DDAS_AI_EMBEDDING_MODEL=text-embedding-004
DDAS_AI_EMBEDDING_DIMENSION=768
DDAS_AI_CHAT_MODEL=gemini-2.5-flash
