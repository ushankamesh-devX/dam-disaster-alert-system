FROM ghcr.io/astral-sh/uv:0.13.0 AS uv
FROM python:3.12-slim

COPY --from=uv /uv /bin/uv
WORKDIR /mlflow
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system "mlflow-skinny>=3.17.2" flask flask-cors gunicorn alembic huey pandas aiohttp graphene pymysql boto3 cryptography

# Inject official compiled MLflow React UI assets so the web dashboard renders
COPY static-mlflow-ui /usr/local/lib/python3.12/site-packages/mlflow/server/js/build

EXPOSE 5000
ENTRYPOINT ["mlflow", "server"]
