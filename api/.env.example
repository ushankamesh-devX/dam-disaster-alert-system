# Environment variables for Docker Compose
# DO NOT COMMIT THIS FILE TO GIT!

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_USER=ddas_user
MYSQL_PASSWORD=your_strong_user_password_here

# First administrator login (created when API starts after schema setup).
# Set these before running setup_demo.py. Existing administrators are preserved.
# If both email and password are blank, administrator creation is disabled.
DDAS_ADMIN_EMAIL=admin@ddas.gov.lk
DDAS_ADMIN_PASSWORD=Admin@123
DDAS_ADMIN_NAME=DDAS Administrator

