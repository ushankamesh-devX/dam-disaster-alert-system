# Environment variables for Docker Compose
# DO NOT COMMIT THIS FILE TO GIT!

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_USER=ddas_user
MYSQL_PASSWORD=your_strong_user_password_here

# First administrator login (created when API starts after schema setup).
# Set these before running setup_demo.py. Existing administrators are preserved.
# If both email and password are blank, administrator creation is disabled.
DDAS_ADMIN_EMAIL=admin@ddas.gov.lk
DDAS_ADMIN_PASSWORD=Admin@123
DDAS_ADMIN_NAME=DDAS Administrator

# MQTT Broker (Eclipse Mosquitto)
# Development: leave blank (allow_anonymous true in mosquitto.conf)
# Production:  set credentials and change allow_anonymous to false
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================================================
# SMS Configuration (Step 6) — Twilio Setup
# ============================================================================
# SMS provider: mock (development) | twilio (production)
# For production SMS alerts, sign up at https://www.twilio.com/try-twilio
SMS_PROVIDER=mock
SMS_ENABLED=false

# Twilio Credentials (required when SMS_PROVIDER=twilio)
# Get these from your Twilio Console Dashboard:
#   1. Account SID: Dashboard → Account Info → Account SID
#   2. Auth Token:  Dashboard → Account Info → Auth Token
#   3. From Number: Phone Numbers → Buy a Number (Sri Lanka: +94)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
