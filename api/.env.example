# Environment variables for Docker Compose
# DO NOT COMMIT THIS FILE TO GIT!

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_USER=ddas_user
MYSQL_PASSWORD=your_strong_user_password_here

# First administrator login (created when API starts after schema setup).
# Set these before running setup_demo.py. Existing administrators are preserved.
# If both email and password are blank, administrator creation is disabled.
DDAS_ADMIN_EMAIL=admin@ddas.gov.lk
DDAS_ADMIN_PASSWORD=Admin@123
DDAS_ADMIN_NAME=DDAS Administrator

# MQTT Broker (Eclipse Mosquitto)
# Development: leave blank (allow_anonymous true in mosquitto.conf)
# Production:  set credentials and change allow_anonymous to false
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================================================
# SMS Configuration (Step 6) — Notify.lk Setup
# ============================================================================
# SMS provider: mock (development) | notifylk (production)
SMS_PROVIDER=mock
SMS_ENABLED=false

# Notify.lk credentials (required when SMS_PROVIDER=notifylk)
# From the Notify.lk dashboard: Settings → API Keys
NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=NotifyDEMO

# ============================================================================
# ML Internal Service Authentication — Phase 1
# ============================================================================
# Dedicated ML internal service token for FastAPI -> Spring read access.
# Minimum 32 characters; must match DDAS_AI_SPRING_SERVICE_TOKEN in ai/.env.
DDAS_AI_SPRING_SERVICE_TOKEN=your_32_plus_char_spring_data_token_here

# Service token for Spring -> FastAPI (predictions, jobs, RAG).
# Minimum 32 characters; must match DDAS_AI_INCOMING_SERVICE_TOKEN in ai/.env.
DDAS_AI_INCOMING_SERVICE_TOKEN=your_32_plus_char_incoming_token_here

# URL of the AI FastAPI service (localhost:8000 for local development)
DDAS_AI_BACKEND_URL=http://localhost:8000
