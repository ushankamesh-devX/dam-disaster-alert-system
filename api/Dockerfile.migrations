FROM ghcr.io/astral-sh/uv:0.13.0 AS uv
FROM mysql:8.0
USER root
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/usr/local/bin
RUN uv python install 3.12 --default
WORKDIR /app
COPY scripts/ ./scripts/
COPY ["DB SCHEMA/", "./DB SCHEMA/"]
COPY src/main/java/com/ddas/api/entity/ ./src/main/java/com/ddas/api/entity/
ENV DDAS_MYSQL_TRANSPORT=local DDAS_BACKUP_DIR=/backups PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python3", "scripts/initialize_database.py"]
CMD []
