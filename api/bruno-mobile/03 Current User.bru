meta {
  name: Current User
  type: http
  seq: 3
  tags: [
    core
  ]
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: inherit
}

tests {
  test("Expected HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("User details present", function () { expect(res.getBody().data.fullName).to.be.a("string"); expect(res.getBody().data.email).to.be.a("string"); });
}
