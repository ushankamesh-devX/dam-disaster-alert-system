meta {
  name: Auth Test
  type: http
  seq: 3
}

get {
  url: {{base_url}}/auth/test
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response is successful", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
  });
}

