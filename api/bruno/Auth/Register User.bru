meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fullName": "John Doe",
    "email": "kamesh@example.com",
    "phoneNumber": "+94764511038",
    "password": "SecurePass123!",
    "languagePreference": "en"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

script:post-response {
  if (res.body.data && res.body.data.token) {
    bru.setEnvVar("auth_token", res.body.data.token);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains token", function() {
    const data = res.getBody();
    expect(data.data.token).to.be.a('string');
  });
}
