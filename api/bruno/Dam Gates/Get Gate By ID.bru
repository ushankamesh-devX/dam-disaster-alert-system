meta {
  name: Get Gate By ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/dams/gates/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains gate data", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('gateNumber');
    expect(data).to.have.property('gateType');
  });
}
