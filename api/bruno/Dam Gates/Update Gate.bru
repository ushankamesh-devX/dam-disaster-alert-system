meta {
  name: Update Gate
  type: http
  seq: 5
}

put {
  url: {{base_url}}/dams/gates/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "currentOpeningMeters": 5.0,
    "status": "partial"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains updated gate", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
  });
}
