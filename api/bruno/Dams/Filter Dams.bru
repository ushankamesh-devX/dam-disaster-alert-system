meta {
  name: Filter Dams
  type: http
  seq: 10
}

get {
  url: {{base_url}}/dams/filter
  body: none
  auth: bearer
}

params:query {
  ~status: operational
  ~regionId: 1
  ~hazardStatus: safe
  ~page: 0
  ~size: 20
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response is paginated", function() {
    const data = res.getBody();
    expect(data).to.have.property('content');
  });
}
