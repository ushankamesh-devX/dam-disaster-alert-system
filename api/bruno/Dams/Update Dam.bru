meta {
  name: Update Dam
  type: http
  seq: 12
}

put {
  url: {{base_url}}/dams/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "name": "Victoria Dam - Updated",
    "status": "under_maintenance"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains updated dam", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
  });
}
