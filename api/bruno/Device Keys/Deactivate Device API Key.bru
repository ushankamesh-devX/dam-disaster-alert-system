meta {
  name: Deactivate Device API Key
  type: http
  seq: 5
}

put {
  url: {{base_url}}/device-keys/1/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
