meta {
  name: Get All Device API Keys
  type: http
  seq: 1
}

get {
  url: {{base_url}}/device-keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
