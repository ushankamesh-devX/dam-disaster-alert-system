meta {
  name: Regenerate Device API Key
  type: http
  seq: 7
}

post {
  url: {{base_url}}/device-keys/1/regenerate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains new API key", function() {
    const data = res.getBody();
    expect(data.data).to.have.property('apiKey');
    expect(data.data.apiKey).to.contain('ddasdk_');
  });
}
