meta {
  name: Get Active Hazard Zones
  type: http
  seq: 2
}

get {
  url: {{base_url}}/dams/1/hazard-zones/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains active zones", function() {
    const data = res.getBody();
    expect(data).to.be.an('array');
  });
}
