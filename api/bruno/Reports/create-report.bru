meta {
  name: Create Report
  type: http
  seq: 1
}

post {
  url: {{base_url}}/reports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "reportTypeId": 1,
    "damId": 1,
    "latitude": 6.9271,
    "longitude": 79.8612,
    "locationDescription": "Near spillway gate #2",
    "title": "Crack observed on dam wall",
    "description": "A visible crack approximately 2 meters long was observed on the eastern wall of the dam near spillway gate #2. The crack appears to have formed recently.",
    "priority": "high",
    "isAnonymous": false,
    "media": [
      {
        "fileName": "crack_photo_1.jpg",
        "filePath": "/uploads/reports/crack_photo_1.jpg",
        "fileUrl": "https://cdn.example.com/reports/crack_photo_1.jpg",
        "fileType": "image",
        "mimeType": "image/jpeg",
        "fileSizeBytes": 2048576,
        "width": 1920,
        "height": 1080,
        "caption": "Crack on eastern wall",
        "isPrimary": true
      },
      {
        "fileName": "crack_video_1.mp4",
        "filePath": "/uploads/reports/crack_video_1.mp4",
        "fileUrl": "https://cdn.example.com/reports/crack_video_1.mp4",
        "fileType": "video",
        "mimeType": "video/mp4",
        "fileSizeBytes": 15728640,
        "width": 1920,
        "height": 1080,
        "durationSeconds": 30,
        "thumbnailUrl": "https://cdn.example.com/reports/crack_video_1_thumb.jpg",
        "caption": "Video of the crack"
      }
    ]
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("report_id", res.body.id);
  }
}
