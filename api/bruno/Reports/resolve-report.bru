meta {
  name: Resolve Report
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/reports/{{report_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "status": "resolved",
    "notes": "Issue has been fixed by the maintenance team",
    "resolutionNotes": "Crack was repaired and sealed. Structural integrity confirmed by engineer inspection."
  }
}
