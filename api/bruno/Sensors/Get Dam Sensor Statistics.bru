meta {
  name: Get Dam Sensor Statistics
  type: http
  seq: 17
}

get {
  url: {{base_url}}/sensors/dam/1/statistics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains dam statistics", function() {
    const data = res.getBody();
    expect(data).to.have.property('totalSensors');
    expect(data).to.have.property('activeSensors');
  });
}
