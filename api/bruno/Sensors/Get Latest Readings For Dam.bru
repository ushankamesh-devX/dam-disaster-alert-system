meta {
  name: Get Latest Readings For Dam
  type: http
  seq: 13
}

get {
  url: {{base_url}}/sensors/dam/1/readings/latest
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains readings array", function() {
    const data = res.getBody();
    expect(data).to.be.an('array');
  });
}
