meta {
  name: Get By UUID
  type: http
  seq: 2
}

get {
  url: {{base_url}}/system-safe-locations/uuid/{{safe_location_uuid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJrYW1lc2hAZXhhbXBsZS5jb20iLCJpYXQiOjE3NzIxMzQwMDEsImV4cCI6MTc3MjIyMDQwMX0.ylzfXzNaJQVZ3-wSbeIZ8cbHfTdRNIYz3gbQwiufov-Z5C5_5ZqaW5ORvqVSvM1wsHjlcoAVrCUDaYqBT2WVPA
