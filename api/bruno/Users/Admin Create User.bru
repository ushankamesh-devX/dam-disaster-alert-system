meta {
  name: Admin Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fullName": "New User",
    "email": "newuser@example.com",
    "phoneNumber": "+94771234568",
    "password": "password123",
    "roleId": 2,
    "languagePreference": "en",
    "status": "active"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080/api/v1
}
