meta {
  name: Update User Role
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/users/1/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "roleId": 2,
    "reason": "Promoted to admin"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080/api/v1
}
