meta {
  name: Create News Article
  type: http
  seq: 4
}

post {
  url: {{base_url}}/news-articles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "categoryId": 1,
    "title": "Heavy Rain Warning",
    "titleSi": "තද වැසි පිළිබඳ අනතුරු ඇඟවීම",
    "summary": "Heavy rain is expected in multiple districts over the next 24 hours.",
    "summarySi": "ඉදිරි පැය 24 තුළ දිස්ත්‍රික්ක කිහිපයකට තද වැසි අපේක්ෂා කෙරේ.",
    "content": "The Department of Meteorology has issued a severe weather warning...",
    "contentSi": "කාලගුණ විද්‍යා දෙපාර්තමේන්තුව විසින් දැඩි කාලගුණ අනතුරු ඇඟවීමක් නිකුත් කර ඇත...",
    "priorityLevel": "high",
    "source": "Meteorology Dept",
    "isNationwide": true,
    "status": "draft",
    "isFeatured": true
  }
}

script:post-response {
  // Automatically save the created article's ID for use in other requests
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("article_id", res.body.data.id);
  } else if (res.body.id) {
    bru.setEnvVar("article_id", res.body.id);
  }
}
