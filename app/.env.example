# Mobile App Environment Configuration Template
# Note: Running `npm.cmd run mobile:tunnel` automatically generates `.env.local`
# with the active local proxy credentials.

# Local API URL (default: http://localhost:8080/api/v1)
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT=20000
API_USE_EXPO_PROXY=true

# Optional demo credentials for quick preview (auto-managed in .env.local)
VIEWER_EMAIL=
VIEWER_PASSWORD=
TEST_TOKEN=
