{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --go --tunnel --port 8082 --clear",
    "mobile:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "mobile:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1 -Usb",
    "mobile:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1 -Usb -Build",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:auth": "node --test scripts/api-auth.test.cjs",
    "test:metro": "node --test scripts/metro-compat.test.cjs",
    "test:dashboard": "node --test scripts/dashboard.test.cjs",
    "test:reports": "node --test scripts/reports.test.cjs",
    "test:assistant": "node --test scripts/assistant.test.cjs scripts/answer-format.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "axios": "^1.16.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.20",
    "expo-doctor": "^1.17.14",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.8.0",
    "markdown-it": "^15.0.3",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-native": "0.86.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
